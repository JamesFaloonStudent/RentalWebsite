## Backend Server Environment Variables

JWT_KEY="your-jwt-key-here";
AdminRoleId = "test-role-id";
AdminUserId = "test-user-id";

# --- Stripe ---
# Use the local stripe-mock container (http://localhost:12111) instead of the real Stripe API.
# Dev only. With it on, STRIPE_SECRET_KEY is ignored.
STRIPE_MOCK=true

# Real Stripe test-mode secret key (Dashboard > Developers > API keys). Never commit a real value.
STRIPE_SECRET_KEY=sk_test_replace_me

# Signing secret for POST /api/stripe/webhook. For local testing use the `whsec_...` value
# printed by `stripe listen --forward-to localhost:5000/api/stripe/webhook`,
# or the one from the Dashboard endpoint settings.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Public base URL of the frontend, used to build the Stripe Checkout success/cancel redirects.
# Must be an absolute URL. Dev (Vite): http://localhost:3000. Docker: http://localhost:8080.
APP_BASE_URL=http://localhost:3000


## Frontend local development environment variables (Vite)